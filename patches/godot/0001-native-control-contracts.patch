+void RichTextLabel::set_selection_range(int p_from, int p_to) {
+	ERR_MAIN_THREAD_GUARD;
+	_validate_line_caches();
+	if (!selection.enabled || p_from < 0 || p_to <= p_from) {
+		deselect();
+		return;
+	}
+	deselect();
+	p_from = MIN(p_from, get_total_character_count());
+	p_to = MIN(p_to, get_total_character_count());
+	for (int i = 0; i < (int)main->lines.size(); ++i) {
+		const Line &line = main->lines[i];
+		Item *to = i + 1 < (int)main->lines.size() ? main->lines[i + 1].from : nullptr;
+		if (p_from >= line.char_offset && p_from < line.char_offset + line.char_count) {
+			selection.from_frame = main;
+			selection.from_line = i;
+			selection.from_char = p_from - line.char_offset;
+			selection.from_item = _get_item_at_pos(line.from, to, selection.from_char);
+		}
+		if (p_to > line.char_offset && p_to <= line.char_offset + line.char_count) {
+			selection.to_frame = main;
+			selection.to_line = i;
+			selection.to_char = p_to - line.char_offset;
+			selection.to_item = _get_item_at_pos(line.from, to, selection.to_char);
+		}
+	}
+	selection.active = p_to > p_from && selection.from_frame && selection.to_frame;
+	queue_redraw();
+	queue_accessibility_update();
+}
+
+bool RichTextLabel::validate_detached_layout() {
+	ERR_MAIN_THREAD_GUARD_V(false);
+	if (is_inside_tree() || threaded) {
+		return false;
+	}
+	_update_theme_item_cache();
+	detached_layout_validation = true;
+	const bool valid = _validate_line_caches();
+	detached_layout_validation = false;
+	return valid;
+}
+
+void RichTextLabel::set_line_height_override(float p_height) {
+	ERR_FAIL_COND(!Math::is_finite(p_height) || p_height < 0);
+	if (line_height_override == p_height) {
+		return;
+	}
+	line_height_override = p_height;
+	main->first_invalid_line.store(0);
+	queue_redraw();
+}
+
+void RichTextLabel::set_visible_line_limit(int p_lines) {
+	ERR_FAIL_COND(p_lines < -1);
+	if (visible_line_limit == p_lines) {
+		return;
+	}
+	visible_line_limit = p_lines;
+	main->first_invalid_line.store(0);
+	queue_redraw();
+}
