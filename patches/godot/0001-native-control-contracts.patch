+Dictionary RichTextLabel::get_text_layout_snapshot(const Array &p_ranges) {
+	ERR_MAIN_THREAD_GUARD_V(Dictionary());
+	if (!is_inside_tree()) {
+		validate_detached_layout();
+	} else {
+		_validate_line_caches();
+	}
+	Dictionary snapshot;
+	Array lines;
+	Array ranges;
+	for (int i = 0; i < p_ranges.size(); ++i) {
+		ranges.push_back(Array());
+	}
+	const Rect2 rect = _get_text_rect();
+	for (int paragraph = 0; paragraph < (int)main->lines.size(); ++paragraph) {
+		const Line &line = main->lines[paragraph];
+		const Ref<TextParagraph> &buffer = line.text_buf_disp.is_valid() ? line.text_buf_disp : line.text_buf;
+		float y = rect.position.y + line.offset.y;
+		for (int row = 0; row < buffer->get_visible_line_count(); ++row) {
+			const Vector2i range = buffer->get_line_range(row);
+			const float ascent = buffer->get_line_ascent(row);
+			const float height = ascent + buffer->get_line_descent(row);
+			const float width = buffer->get_line_width(row);
+			float x = rect.position.x + line.offset.x;
+			if (buffer->get_alignment() == HORIZONTAL_ALIGNMENT_CENTER) {
+				x += Math::floor((buffer->get_width() - width) / 2);
+			} else if ((buffer->get_alignment() == HORIZONTAL_ALIGNMENT_RIGHT && !is_layout_rtl()) || (buffer->get_alignment() == HORIZONTAL_ALIGNMENT_LEFT && is_layout_rtl())) {
+				x += buffer->get_width() - width;
+			}
+			Dictionary record;
+			record["from"] = line.char_offset + range.x;
+			record["to"] = line.char_offset + range.y;
+			record["bounds"] = Rect2(x, y, width, height);
+			record["baseline"] = y + ascent;
+			lines.push_back(record);
+			for (int i = 0; i < p_ranges.size(); ++i) {
+				const Vector2i requested = p_ranges[i];
+				const int start = MAX(range.x, requested.x - line.char_offset);
+				const int end = MIN(range.y, requested.y - line.char_offset);
+				if (end <= start) {
+					continue;
+				}
+				Array bounds = ranges[i];
+				for (const Vector2 &segment : TS->shaped_text_get_selection(buffer->get_line_rid(row), start, end)) {
+					bounds.push_back(Rect2(x + segment.x, y, segment.y - segment.x, height));
+				}
+			}
+			y += height + theme_cache.line_separation;
+		}
+	}
+	snapshot["lines"] = lines;
+	snapshot["ranges"] = ranges;
+	return snapshot;
+}
