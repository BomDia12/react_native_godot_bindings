+void LineEdit::_emit_pending_text_changed(uint64_t p_revision) {
+	if (p_revision == edit_state_revision && text_changed_dirty) {
+		_text_changed();
+	}
+}
+
+std::shared_ptr<const LineEdit::EditState> LineEdit::capture_edit_state() const {
+	auto state = std::make_shared<EditState>();
+	state->owner = get_instance_id();
+	state->text = text;
+	state->undo_text = undo_text;
+	state->ime_text = ime_text;
+	state->ime_selection = ime_selection;
+	state->selection = selection;
+	state->caret_column = caret_column;
+	state->scroll_offset = scroll_offset;
+	state->undo_stack = undo_stack;
+	int index = 0;
+	for (const auto *entry = undo_stack.front(); entry; entry = entry->next(), ++index) {
+		if (entry == undo_stack_pos) {
+			state->undo_position = index;
+		}
+	}
+	state->text_changed_dirty = text_changed_dirty;
+	state->editing = editing;
+	return state;
+}
+
+void LineEdit::restore_edit_state(const std::shared_ptr<const EditState> &p_state) {
+	ERR_FAIL_COND(!p_state || p_state->owner != get_instance_id());
+	++edit_state_revision;
+	text = p_state->text;
+	undo_text = p_state->undo_text;
+	ime_text = p_state->ime_text;
+	ime_selection = p_state->ime_selection;
+	selection = p_state->selection;
+	caret_column = p_state->caret_column;
+	scroll_offset = p_state->scroll_offset;
+	undo_stack = p_state->undo_stack;
+	undo_stack_pos = nullptr;
+	int undo_index = 0;
+	for (auto *entry = undo_stack.front(); entry; entry = entry->next(), ++undo_index) {
+		if (undo_index == p_state->undo_position) {
+			undo_stack_pos = entry;
+		}
+	}
+	text_changed_dirty = p_state->text_changed_dirty;
+	editing = p_state->editing;
+	_shape();
+	queue_redraw();
+	if (text_changed_dirty && is_inside_tree()) {
+		callable_mp(this, &LineEdit::_emit_pending_text_changed).call_deferred(edit_state_revision);
+	}
+}
+
+void LineEdit::discard_pending_edit_notifications() {
+	++edit_state_revision;
+	text_changed_dirty = false;
+}
