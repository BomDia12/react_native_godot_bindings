+std::shared_ptr<const TextEdit::EditState> TextEdit::capture_edit_state() const {
+	auto state = std::make_shared<EditState>();
+	state->owner = get_instance_id();
+	state->text = text.snapshot_copy();
+	state->carets = carets;
+	state->ime_text = ime_text;
+	state->ime_selection = ime_selection;
+	state->undo_stack = undo_stack;
+	int index = 0;
+	for (const auto *entry = undo_stack.front(); entry; entry = entry->next(), ++index) {
+		if (entry == undo_stack_pos) {
+			state->undo_position = index;
+		}
+	}
+	state->current_op = current_op;
+	state->current_action = current_action;
+	state->pending_action_end = pending_action_end;
+	state->in_action = in_action;
+	state->complex_operation_count = complex_operation_count;
+	state->next_operation_is_complex = next_operation_is_complex;
+	state->multicaret_edit_count = multicaret_edit_count;
+	state->multicaret_edit_merge_queued = multicaret_edit_merge_queued;
+	state->multicaret_edit_ignore_carets = multicaret_edit_ignore_carets;
+	state->version = version;
+	state->saved_version = saved_version;
+	state->text_changed_dirty = text_changed_dirty;
+	state->caret_pos_dirty = caret_pos_dirty;
+	state->first_visible_line = first_visible_line;
+	state->first_visible_line_wrap_ofs = first_visible_line_wrap_ofs;
+	state->first_visible_col = first_visible_col;
+	state->h_scroll = h_scroll->get_value();
+	state->v_scroll = v_scroll->get_value();
+	state->idle_time = idle_detect->get_time_left();
+	state->scrolling = scrolling;
+	state->target_v_scroll = target_v_scroll;
+	return state;
+}
+
+void TextEdit::restore_edit_state(const std::shared_ptr<const EditState> &p_state) {
+	ERR_FAIL_COND(!p_state || p_state->owner != get_instance_id());
+	++edit_state_revision;
+	text = p_state->text.snapshot_copy();
+	carets = p_state->carets;
+	ime_text = p_state->ime_text;
+	ime_selection = p_state->ime_selection;
+	undo_stack = p_state->undo_stack;
+	undo_stack_pos = nullptr;
+	int undo_index = 0;
+	for (auto *entry = undo_stack.front(); entry; entry = entry->next(), ++undo_index) {
+		if (undo_index == p_state->undo_position) {
+			undo_stack_pos = entry;
+		}
+	}
+	current_op = p_state->current_op;
+	current_action = p_state->current_action;
+	pending_action_end = p_state->pending_action_end;
+	in_action = p_state->in_action;
+	complex_operation_count = p_state->complex_operation_count;
+	next_operation_is_complex = p_state->next_operation_is_complex;
+	multicaret_edit_count = p_state->multicaret_edit_count;
+	multicaret_edit_merge_queued = p_state->multicaret_edit_merge_queued;
+	multicaret_edit_ignore_carets = p_state->multicaret_edit_ignore_carets;
+	version = p_state->version;
+	saved_version = p_state->saved_version;
+	text_changed_dirty = p_state->text_changed_dirty;
+	caret_pos_dirty = p_state->caret_pos_dirty;
+	first_visible_line = p_state->first_visible_line;
+	first_visible_line_wrap_ofs = p_state->first_visible_line_wrap_ofs;
+	first_visible_col = p_state->first_visible_col;
+	_update_scrollbars();
+	h_scroll->set_value(p_state->h_scroll);
+	v_scroll->set_value(p_state->v_scroll);
+	scrolling = p_state->scrolling;
+	target_v_scroll = p_state->target_v_scroll;
+	idle_detect->stop();
+	if (p_state->idle_time > 0 && idle_detect->is_inside_tree()) {
+		idle_detect->start(p_state->idle_time);
+	}
+	queue_redraw();
+	if (is_inside_tree()) {
+		if (text_changed_dirty) {
+			callable_mp(this, &TextEdit::_emit_pending_text_changed).call_deferred(edit_state_revision);
+		}
+		if (caret_pos_dirty) {
+			callable_mp(this, &TextEdit::_emit_pending_caret_changed).call_deferred(edit_state_revision);
+		}
+	}
+}
+
+void TextEdit::discard_pending_edit_notifications() {
+	++edit_state_revision;
+	text_changed_dirty = false;
+	caret_pos_dirty = false;
+}
