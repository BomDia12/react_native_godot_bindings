+#include <src/utils/utils.h>
+
+#include <cstdlib>
+#include <map>
+
+namespace {
+
+class ScopedWebPAllocations {
+	static thread_local ScopedWebPAllocations *current;
+	ScopedWebPAllocations *previous = nullptr;
+	WebPScopedAlloc previous_allocate = nullptr;
+	WebPScopedFree previous_release = nullptr;
+	std::map<void *, uint64_t> allocations;
+	uint64_t used = 0;
+	uint64_t limit = 0;
+
+	static void *allocate(size_t p_size, int p_clear) {
+		const uint64_t overhead = 128;
+		if (current->used > current->limit || p_size > current->limit - current->used || overhead > current->limit - current->used - p_size) {
+			return nullptr;
+		}
+		void *pointer = p_clear ? std::calloc(1, p_size) : std::malloc(p_size);
+		if (pointer) {
+			current->allocations.emplace(pointer, p_size + overhead);
+			current->used += p_size + overhead;
+		}
+		return pointer;
+	}
+
+	static void release(void *p_pointer) {
+		const auto found = current->allocations.find(p_pointer);
+		if (found != current->allocations.end()) {
+			current->used -= found->second;
+			current->allocations.erase(found);
+			std::free(p_pointer);
+		} else if (current->previous_release) {
+			auto *owner = current;
+			current = owner->previous;
+			owner->previous_release(p_pointer);
+			current = owner;
+		} else {
+			std::free(p_pointer);
+		}
+	}
+
+public:
+	ScopedWebPAllocations() {
+		limit = Image::get_load_limits().max_workspace_bytes;
+		if (limit) {
+			previous = current;
+			WebPGetScopedAllocationHooks(&previous_allocate, &previous_release);
+			current = this;
+			WebPSetScopedAllocationHooks(allocate, release);
+		}
+	}
+
+	~ScopedWebPAllocations() {
+		if (limit) {
+			WebPSetScopedAllocationHooks(previous_allocate, previous_release);
+			current = previous;
+		}
+	}
+};
+
+thread_local ScopedWebPAllocations *ScopedWebPAllocations::current = nullptr;
