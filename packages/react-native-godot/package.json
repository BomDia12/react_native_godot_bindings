    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "metro": "0.87.0",
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
