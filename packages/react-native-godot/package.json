{
  "name": "react-native-godot",
  "version": "0.1.0",
  "description": "Godot platform for React Native",
  "license": "MIT",
  "exports": {
    "./metro": "./metro.cjs",
    "./resolver": "./resolver.cjs",
    "./assets": "./assets.cjs",
    "./app-registry": "./src/app-registry.js",
    "./scene": "./src/scene.js",
    "./GodotWindow": "./src/GodotWindow.js",
    "./fonts": "./src/fonts.js",
    "./values": "./src/values.js",
    "./package.json": "./package.json",
    "./setup": "./src/setup.js",
    "./specs/*": "./specs/*.js"
  },
  "types": "./godot.d.ts",
  "bin": {
