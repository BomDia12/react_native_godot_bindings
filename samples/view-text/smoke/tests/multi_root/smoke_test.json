{
  "id": "multi-root",
  "project_dir": "samples/view-text",
  "scene": "res://smoke/tests/multi_root/MultiRoot.tscn",
  "timeout_seconds": 90,
  "allowlist": "documentation/expected-warnings-multi-root.txt",
  "bundle": {
    "mode": "shared",
    "package_dir": "samples/view-text",
    "script": "build:godot",
    "output": "samples/view-text/dist/godot.bundle.js"
  },
  "inputs": [
    "samples/view-text/project.godot",
    "samples/view-text/godot.entry.js",
    "samples/view-text/interaction.entry.js",
    "samples/view-text/multi_root.entry.js",
    "samples/view-text/godot.preamble.js",
    "samples/view-text/metro.config.godot.js",
    "samples/view-text/babel.config.js",
    "samples/view-text/package.json",
    "samples/view-text/package-lock.json",
    "documentation/expected-warnings.txt",
    "documentation/expected-warnings-multi-root.txt",
    "samples/view-text/smoke/tests/multi_root/MultiRoot.tscn",
    "samples/view-text/smoke/tests/multi_root/multi_root.gd"
  ]
}
