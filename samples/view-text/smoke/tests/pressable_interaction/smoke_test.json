    "samples/view-text/babel.config.js",
    "samples/view-text/package.json",
    "samples/view-text/package-lock.json",
    "documentation/expected-warnings.txt",
    "samples/view-text/smoke/tests/pressable_interaction/SmokeMain.tscn",
    "samples/view-text/smoke/tests/pressable_interaction/pressable_interaction.gd"
  ]
}
