{
  "id": "component-registry",
  "project_dir": "samples/view-text",
  "scene": "res://smoke/tests/component_registry/ComponentRegistry.tscn",
  "timeout_seconds": 60,
  "allowlist": "documentation/expected-warnings-component-registry.txt",
  "bundle": {
    "mode": "shared",
    "package_dir": "samples/view-text",
    "script": "build:godot",
