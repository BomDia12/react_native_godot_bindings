  },
  "inputs": [
    "samples/view-text/project.godot",
    "samples/view-text/package.json",
    "samples/view-text/package-lock.json",
    "samples/view-text/godot.entry.js",
    "samples/view-text/component_registry.entry.js",
    "packages/react-native-godot/specs/RNExampleMeterNativeComponent.js",
    "packages/react-native-godot/Libraries/NativeComponent/BaseViewConfig.godot.js",
    "documentation/expected-warnings-component-registry.txt",
    "samples/view-text/smoke/tests/component_registry/ComponentRegistry.tscn",
    "samples/view-text/smoke/tests/component_registry/component_registry.gd"
  ]
}
