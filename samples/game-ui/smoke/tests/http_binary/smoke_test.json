{
  "id": "game-http-binary",
  "project_dir": "samples/game-ui",
  "scene": "res://smoke/tests/http_binary/SmokeMain.tscn",
  "timeout_seconds": 90,
  "allowlist": "documentation/expected-warnings.txt",
  "bundle": {
    "mode": "shared",
    "package_dir": "samples/game-ui",
    "script": "build:godot",
    "output": "samples/game-ui/dist/game.bundle.js"
  },
  "inputs": [
    "documentation/expected-warnings.txt",
    "samples/game-ui/assets/LICENSE.OpenSans.txt",
    "samples/game-ui/assets/OpenSans.woff2",
    "samples/game-ui/assets/item.png",
    "samples/game-ui/assets/item@2x.png",
    "samples/game-ui/assets/item@3x.png",
    "samples/game-ui/babel.config.js",
    "samples/game-ui/game/GameDemo.tscn",
    "samples/game-ui/game/enemy.gd",
    "samples/game-ui/game/game.gd",
    "samples/game-ui/game/inventory.gd",
    "samples/game-ui/game/schemas.gd",
    "samples/game-ui/godot.entry.js",
    "samples/game-ui/metro.config.godot.js",
    "samples/game-ui/package-lock.json",
    "samples/game-ui/package.json",
    "samples/game-ui/project.godot",
    "samples/game-ui/smoke/game_test.gd",
    "samples/game-ui/smoke/tests/http_binary/case.gd",
    "samples/game-ui/smoke/tests/http_binary/SmokeMain.tscn",
    "samples/game-ui/fixtures/network.json",
    "samples/game-ui/fixtures/tls/ca.pem",
    "samples/game-ui/fixtures/tls/server-key.pem",
    "samples/game-ui/game/network.js"
  ],
  "fixture": {
    "kind": "local_network",
    "config": "samples/game-ui/fixtures/network.json"
  }
}
