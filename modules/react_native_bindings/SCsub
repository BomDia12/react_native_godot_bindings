#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

import glob
import json
import os
import sys

env_rn = env_modules.Clone()

module_dir = env.Dir(".").srcnode().abspath
hermes_source_dir = os.path.join(module_dir, "engines", "hermes")
hermes_api_dir = os.path.join(hermes_source_dir, "API")
hermes_include_dir = os.path.join(hermes_source_dir, "include")

hermes_platform = {"linuxbsd": "linux", "android": "android"}[env["platform"]]
hermes_variant = "%s-%s%s" % (hermes_platform, env["arch"], "-debugger" if env.debug_features else "")
hermes_build_dir = os.path.join(module_dir, "engines", "build", hermes_variant)
hermes_archives = [
	os.path.join(hermes_build_dir, "lib", "libhermesvm_a.a"),
	os.path.join(hermes_build_dir, "jsi", "libjsi.a"),
] + glob.glob(os.path.join(hermes_build_dir, "external", "boost", "*", "libs", "context", "libboost_context.a"))
if env["platform"] == "linuxbsd":
	icu_lib_dir = os.path.join(module_dir, "engines", "build", "icu-linux-x86_64", "lib")
	hermes_archives += [os.path.join(icu_lib_dir, name) for name in ("libicui18n.a", "libicuuc.a", "libicudata.a")]

for required_path in [hermes_api_dir, hermes_include_dir] + hermes_archives:
	if not os.path.exists(required_path):
		raise RuntimeError(
			"Hermes dependency not found at %s. Run scripts/build_hermes.sh %s from the binding repository root."
			% (required_path, hermes_variant)
		)

sys.path.insert(0, module_dir)
import react_native_sources

react_native_sources.configure_third_party()

env_rn.Append(
	CXXFLAGS=["-isystem%s" % path for path in react_native_sources.hermes_include_dirs() + react_native_sources.include_dirs()[1:]]
)
env_rn.Prepend(CPPPATH=[react_native_sources.REACT_PLATFORM_DIR])
# Godot platform headers under react_platform/ include module headers by module-relative path.
env_rn.Append(CPPPATH=[module_dir])
react_native_defines = react_native_sources.react_native_defines(env.debug_features)
env_rn.Append(CPPDEFINES=react_native_defines)

env.Append(LIBS=[env.File(path) for path in hermes_archives])
# Upstream feature flags keep std::atomic<std::optional<double>>, whose 16-byte
# operations GCC lowers to libatomic calls.
if env["platform"] == "linuxbsd":
	env.Append(LIBS=[":libatomic.a"])

if env["platform"] in ("linuxbsd", "android"):
	for command in ("LINKCOM", "SHLINKCOM"):
		env[command] = env[command].replace("$_LIBFLAGS", "-Wl,--start-group $_LIBFLAGS -Wl,--end-group")

env_rn.Append(CXXFLAGS=["-std=c++20", "-fexceptions", "-frtti"], CCFLAGS=["-fexceptions"])

# Codegen output of the libraries that `react-native autolink-godot` linked.
autolinked_codegen = []
if env["react_native_autolinking"]:
	with open(env["react_native_autolinking"], encoding="utf-8") as manifest:
		autolinked_codegen = json.load(manifest)["codegen"]
env_rn.Append(CXXFLAGS=["-isystem%s" % path for path in autolinked_codegen])
# These objects reach the platform's props through -isystem headers, which SCons
# doesn't scan. A props change has to rebuild them, or they read the old layout.
platform_headers_hash = react_native_sources.platform_headers_hash(autolinked_codegen)
env_rn.Append(CPPDEFINES=[("RN_PLATFORM_HEADERS_HASH", platform_headers_hash)])

# Modules that extend React Native build with this environment.
env_react_native = env_rn.Clone()
Export("env_react_native")

# Module sources. Listed explicitly: SCons' Glob has no recursive "**", so the old
# "**/*.cpp" only ever matched one directory deep. An explicit list is what keeps
# engines/hermes out of the build and lets nested sources in. Add new folders here.
module_objects = []
env_rn.add_source_files(module_objects, "*.cpp")

module_source_dirs = [
	"components",
	"editor",
	"host",
	"input",
	"interop",
	"mounting",
	"native_modules",
	"root_view",
	"singletons",
	"turbomodules",
]

for subdir in module_source_dirs:
	env_rn.add_source_files(module_objects, "%s/*.cpp" % subdir)

if env["tests"]:
	env_rn.Append(CPPDEFINES=["TESTS_ENABLED"])
	env_rn.add_source_files(module_objects, "tests/*.cpp")

env_rn.Depends(module_objects, hermes_archives)
env.modules_sources.extend(module_objects)

# Upstream React Native and its third-party libraries build in their own cloned
# environment so their warnings stay out of the module build.
def relative_sources(paths):
	return [os.path.relpath(path, module_dir) for path in paths]


env_upstream = env_modules.Clone()
env_upstream.disable_warnings()
env_upstream.Prepend(CPPPATH=react_native_sources.include_dirs() + [module_dir])
env_upstream.Append(CXXFLAGS=["-isystem%s" % path for path in react_native_sources.hermes_include_dirs()])
env_upstream.Append(CPPDEFINES=react_native_defines)
env_upstream.Append(CXXFLAGS=["-std=c++20", "-fexceptions", "-frtti"], CCFLAGS=["-fexceptions"])
# Upstream builds with libc++, whose headers provide the fixed-width integer types
# that several React Native sources use without including <cstdint>.
env_upstream.Append(CXXFLAGS=["-include", "cstdint"])
env_upstream.Append(CXXFLAGS=["-isystem%s" % path for path in autolinked_codegen])

upstream_objects = []
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.react_native_sources()))
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.generated_sources()))
# Their own headers come through -isystem too, so they need the same hash.
env_autolinked_codegen = env_upstream.Clone()
env_autolinked_codegen.Append(CPPDEFINES=[("RN_PLATFORM_HEADERS_HASH", platform_headers_hash)])
for path in autolinked_codegen:
	env_autolinked_codegen.add_source_files(upstream_objects, relative_sources(react_native_sources.cpp_sources(path)))
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.react_platform_sources()))

third_party = react_native_sources.third_party_sources()
for name in ("folly", "fmt", "double-conversion"):
	env_upstream.add_source_files(upstream_objects, relative_sources(third_party[name]))

env_glog = env_upstream.Clone()
env_glog.Prepend(CPPPATH=react_native_sources.glog_private_include_dirs())
env_glog.Append(CPPDEFINES=["HAVE_PREAD=1"])
env_glog.add_source_files(upstream_objects, relative_sources(third_party["glog"]))

env_upstream.Depends(upstream_objects, hermes_archives)
env.modules_sources.extend(upstream_objects)
