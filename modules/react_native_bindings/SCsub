#!/usr/bin/env python
from misc.utility.scons_hints import *
from SCons.Script import Alias, Copy, Requires

Import("env")
Import("env_modules")

import os
import sys

env_rn = env_modules.Clone()

module_dir = env.Dir(".").srcnode().abspath
hermes_source_dir = os.path.join(module_dir, "engines", "hermes")
hermes_build_dir = os.path.join(module_dir, "engines", "build_release")
hermes_api_dir = os.path.join(hermes_source_dir, "API")
hermes_jsi_dir = os.path.join(hermes_api_dir, "jsi")
hermes_public_dir = os.path.join(hermes_source_dir, "public")
hermes_include_dir = os.path.join(hermes_source_dir, "include")
hermes_lib_dir = os.path.join(hermes_build_dir, "lib")
hermes_jsi_lib_dir = os.path.join(hermes_build_dir, "jsi")
hermes_lib = os.path.join(hermes_lib_dir, "libhermesvm.so")
hermes_jsi_lib = os.path.join(hermes_jsi_lib_dir, "libjsi.so")

for required_path in [hermes_api_dir, hermes_include_dir, hermes_lib, hermes_jsi_lib]:
	if not os.path.exists(required_path):
		raise RuntimeError(
			"Hermes dependency not found at %s. Run scripts/build_hermes.sh from the binding repository root."
			% required_path
		)

sys.path.insert(0, module_dir)
import react_native_sources

react_native_sources.configure_third_party()

env_rn.Append(
	CXXFLAGS=["-isystem%s" % path for path in react_native_sources.hermes_include_dirs() + react_native_sources.include_dirs()[1:]]
)
env_rn.Prepend(CPPPATH=[react_native_sources.REACT_PLATFORM_DIR])
env_rn.Append(CPPDEFINES=react_native_sources.REACT_NATIVE_DEFINES)

env.Prepend(LIBPATH=[hermes_lib_dir, hermes_jsi_lib_dir])
env.AppendUnique(LIBS=["hermesvm", "jsi"])
env.AppendUnique(LINKFLAGS=["-Wl,-rpath,\\$$ORIGIN"])

if env["platform"] == "linuxbsd" and env["library_type"] == "executable":
	env["LINKCOM"] = env["LINKCOM"].replace("$_LIBFLAGS", "-Wl,--start-group $_LIBFLAGS -Wl,--end-group")

env_rn.Append(CXXFLAGS=["-std=c++20", "-fexceptions", "-frtti"], CCFLAGS=["-fexceptions"])

# Module sources. Listed explicitly: SCons' Glob has no recursive "**", so the old
# "**/*.cpp" only ever matched one directory deep. An explicit list is what keeps
# engines/hermes out of the build and lets nested sources in. Add new folders here.
module_objects = []
env_rn.add_source_files(module_objects, "*.cpp")

module_source_dirs = [
	"components",
	"editor",
	"examples",
	"fabric",
	"input",
	"interop",
	"mounting",
	"native_modules",
	"root_view",
	"runtime",
	"singletons",
]

for subdir in module_source_dirs:
	env_rn.add_source_files(module_objects, "%s/*.cpp" % subdir)

if env["tests"]:
	env_rn.Append(CPPDEFINES=["TESTS_ENABLED"])
	env_rn.add_source_files(module_objects, "tests/*.cpp")

env_rn.Depends(module_objects, [hermes_lib, hermes_jsi_lib])
env.modules_sources.extend(module_objects)

# Upstream React Native and its third-party libraries build in their own cloned
# environment so their warnings stay out of the module build.
def relative_sources(paths):
	return [os.path.relpath(path, module_dir) for path in paths]


env_upstream = env_modules.Clone()
env_upstream.disable_warnings()
env_upstream.Prepend(CPPPATH=react_native_sources.include_dirs())
env_upstream.Append(CXXFLAGS=["-isystem%s" % path for path in react_native_sources.hermes_include_dirs()])
env_upstream.Append(CPPDEFINES=react_native_sources.REACT_NATIVE_DEFINES)
env_upstream.Append(CXXFLAGS=["-std=c++20", "-fexceptions", "-frtti"], CCFLAGS=["-fexceptions"])
# Upstream builds with libc++, whose headers provide the fixed-width integer types
# that several React Native sources use without including <cstdint>.
env_upstream.Append(CXXFLAGS=["-include", "cstdint"])

upstream_objects = []
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.react_native_sources()))
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.generated_sources()))
env_upstream.add_source_files(upstream_objects, relative_sources(react_native_sources.react_platform_sources()))

third_party = react_native_sources.third_party_sources()
for name in ("folly", "fmt", "double-conversion"):
	env_upstream.add_source_files(upstream_objects, relative_sources(third_party[name]))

env_glog = env_upstream.Clone()
env_glog.Prepend(CPPPATH=react_native_sources.glog_private_include_dirs())
env_glog.Append(CPPDEFINES=["HAVE_PREAD=1"])
env_glog.add_source_files(upstream_objects, relative_sources(third_party["glog"]))

env_upstream.Depends(upstream_objects, [hermes_lib, hermes_jsi_lib])
env.modules_sources.extend(upstream_objects)

shared_libs = [hermes_lib, hermes_jsi_lib]
bin_dir = env.Dir("#bin").abspath
copy_targets = []

for lib_path in shared_libs:
	target_path = os.path.join(bin_dir, os.path.basename(lib_path))
	target_node = env.Command(target_path, lib_path, Copy("$TARGET", "$SOURCE"))
	copy_targets.append(target_node)

Alias("react_native_bindings_runtime", copy_targets)
if env["library_type"] == "executable":
	Requires(os.path.join(bin_dir, "godot" + env["PROGSUFFIX"]), copy_targets)
