#!/usr/bin/env python
from misc.utility.scons_hints import *
from SCons.Script import Alias, Copy, Requires

Import("env")
Import("env_modules")

import os

env_rn = env_modules.Clone()

module_dir = env.Dir(".").srcnode().abspath
hermes_source_dir = os.path.join(module_dir, "engines", "hermes")
hermes_build_dir = os.path.join(module_dir, "engines", "build_release")
hermes_api_dir = os.path.join(hermes_source_dir, "API")
hermes_jsi_dir = os.path.join(hermes_api_dir, "jsi")
hermes_public_dir = os.path.join(hermes_source_dir, "public")
hermes_include_dir = os.path.join(hermes_source_dir, "include")
hermes_lib_dir = os.path.join(hermes_build_dir, "lib")
hermes_jsi_lib_dir = os.path.join(hermes_build_dir, "jsi")
hermes_lib = os.path.join(hermes_lib_dir, "libhermesvm.so")
hermes_jsi_lib = os.path.join(hermes_jsi_lib_dir, "libjsi.so")

for required_path in [hermes_api_dir, hermes_include_dir, hermes_lib, hermes_jsi_lib]:
	if not os.path.exists(required_path):
		raise RuntimeError(
			"Hermes dependency not found at %s. Run scripts/build_hermes.sh from the binding repository root."
			% required_path
		)

yoga_dir = os.path.join(module_dir, "thirdparty", "yoga")

env_rn.Prepend(CPPPATH=[yoga_dir])
env_rn.Append(
	CXXFLAGS=["-isystem%s" % path for path in [hermes_api_dir, hermes_jsi_dir, hermes_public_dir, hermes_include_dir]]
)

env.Prepend(LIBPATH=[hermes_lib_dir, hermes_jsi_lib_dir])
env.AppendUnique(LIBS=["hermesvm", "jsi"])
env.AppendUnique(LINKFLAGS=["-Wl,-rpath,\\$$ORIGIN"])

if env["platform"] == "linuxbsd" and env["library_type"] == "executable":
	env["LINKCOM"] = env["LINKCOM"].replace("$_LIBFLAGS", "-Wl,--start-group $_LIBFLAGS -Wl,--end-group")

env_rn.Append(CXXFLAGS=["-fexceptions"], CCFLAGS=["-fexceptions"])

# Module sources. Listed explicitly: SCons' Glob has no recursive "**", so the old
# "**/*.cpp" only ever matched one directory deep. An explicit list is what keeps
# engines/hermes out of the build and lets nested sources in. Add new folders here.
env_rn.add_source_files(env.modules_sources, "*.cpp")

module_source_dirs = [
	"editor",
	"fabric",
	"input",
	"root_view",
	"singletons",
]

for subdir in module_source_dirs:
	env_rn.add_source_files(env.modules_sources, "%s/*.cpp" % subdir)

# Yoga (vendored from react-native/ReactCommon/yoga). Built in its own cloned env so
# its warnings stay out of the module build. Header-only: style/, enums/, numeric/.
env_yoga = env_modules.Clone()
env_yoga.disable_warnings()
env_yoga.Prepend(CPPPATH=[yoga_dir])
env_yoga.Append(CXXFLAGS=["-fexceptions", "-std=c++20"], CCFLAGS=["-fexceptions"])
env_yoga.add_source_files(env.modules_sources, "thirdparty/yoga/yoga/*.cpp")

for subdir in ["algorithm", "config", "debug", "event", "node"]:
	env_yoga.add_source_files(env.modules_sources, "thirdparty/yoga/yoga/%s/*.cpp" % subdir)

shared_libs = [hermes_lib, hermes_jsi_lib]
bin_dir = env.Dir("#bin").abspath
copy_targets = []

for lib_path in shared_libs:
	target_path = os.path.join(bin_dir, os.path.basename(lib_path))
	target_node = env.Command(target_path, lib_path, Copy("$TARGET", "$SOURCE"))
	copy_targets.append(target_node)

Alias("react_native_bindings_runtime", copy_targets)
if env["library_type"] == "executable":
	Requires(os.path.join(bin_dir, "godot" + env["PROGSUFFIX"]), copy_targets)
